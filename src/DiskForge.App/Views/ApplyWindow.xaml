<ui:FluentWindow x:Class="DiskForge.App.Views.ApplyWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:conv="clr-namespace:DiskForge.App.Converters"
                 xmlns:vm="clr-namespace:DiskForge.App.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:ApplyViewModel}"
                 Title="{Binding WindowTitle}" Height="560" Width="600"
                 WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding WindowTitle}" />

        <Grid Grid.Row="1" Margin="24,8">
            <!-- CONFIRM -->
            <StackPanel Visibility="{Binding IsConfirm, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Review the plan" FontSize="18" FontWeight="SemiBold" />
                <Border Margin="0,10,0,0" CornerRadius="8" Padding="14,12" Background="#0DFFFFFF"
                        BorderBrush="#1FFFFFFF" BorderThickness="1">
                    <TextBlock Text="{Binding PlanText}" TextWrapping="Wrap" FontSize="13" LineHeight="20" />
                </Border>

                <!-- Elevation gate -->
                <Border Margin="0,14,0,0" CornerRadius="8" Padding="14,12"
                        Background="#26F59E0B" BorderBrush="#66F59E0B" BorderThickness="1"
                        Visibility="{Binding ShowElevationGate, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Administrator required to apply disk operations."
                                   Foreground="#F5B301" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <ui:Button Content="Restart as Administrator" Margin="0,10,0,0"
                                   Command="{Binding RestartAsAdministratorCommand}" />
                    </StackPanel>
                </Border>

                <!-- Destructive summary. This dialog is the confirmation step: nothing runs until the
                     danger button below is pressed. -->
                <Border Margin="0,18,0,0" CornerRadius="8" Padding="14,12"
                        Background="#26EF4444" BorderBrush="#66EF4444" BorderThickness="1"
                        Visibility="{Binding RequiresConfirmation, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Warning24" Foreground="#FCA5A5" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DestructiveWarning}" Foreground="#FCA5A5" Margin="10,0,0,0"
                                   FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- RUNNING -->
            <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                <TextBlock Text="Applying…" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="8" Margin="0,18,0,10" />
                <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center" Opacity="0.8" TextWrapping="Wrap" />
            </StackPanel>

            <!-- DONE (also the whole of a simulation: it opens straight onto its results) -->
            <Grid Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding ResultsHeading}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />

                <!-- Dry-run banner: says plainly that nothing touched a disk. -->
                <Border Grid.Row="1" Margin="0,10,0,0" CornerRadius="8" Padding="14,10"
                        Background="#2638BDF8" BorderBrush="#6638BDF8" BorderThickness="1"
                        Visibility="{Binding IsSimulation, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Beaker24" Foreground="#7DD3FC" VerticalAlignment="Center" />
                        <TextBlock Text="Dry run. This is what Apply would do; no disk was written."
                                   Foreground="#7DD3FC" Margin="10,0,0,0" FontWeight="SemiBold"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Margin="0,10,0,0" CornerRadius="8" Padding="14,12" Background="#0DFFFFFF"
                        BorderBrush="#1FFFFFFF" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                   FontFamily="Cascadia Mono, Consolas, Segoe UI" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#0AFFFFFF" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="CancelButton" Content="Cancel" MinWidth="90" Click="Cancel_Click"
                           Visibility="{Binding IsConfirm, Converter={StaticResource BoolToVis}}" />
                <ui:Button x:Name="ApplyButton" Content="{Binding ConfirmButtonText}" Appearance="Danger"
                           MinWidth="150" Margin="10,0,0,0"
                           IsEnabled="{Binding CanApply}" Command="{Binding ApplyCommand}"
                           Visibility="{Binding IsConfirm, Converter={StaticResource BoolToVis}}" />
                <ui:Button x:Name="CloseButton" Content="Close" Appearance="Primary" MinWidth="120"
                           Click="Close_Click"
                           Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>

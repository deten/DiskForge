<UserControl x:Class="DiskForge.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:DiskForge.App.Converters"
             xmlns:vm="clr-namespace:DiskForge.App.ViewModels"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}">

    <UserControl.Resources>
        <conv:FractionToWidthConverter x:Key="FractionToWidth" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInverse" Invert="True" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
    </UserControl.Resources>

    <Grid Margin="24,16,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Disks" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SummaryText}" Opacity="0.7" Margin="0,2,0,0" />
            </StackPanel>
            <ui:Button Content="Rescan" Icon="{ui:SymbolIcon ArrowSync24}"
                       HorizontalAlignment="Right" VerticalAlignment="Top"
                       Command="{Binding RefreshCommand}"
                       IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
        </Grid>

        <!-- Elevation banner -->
        <Border Grid.Row="1" Margin="0,0,0,16" CornerRadius="8" Padding="14,10"
                Background="#26F59E0B" BorderBrush="#66F59E0B" BorderThickness="1"
                Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisInverse}}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="ShieldError24" Foreground="#F5B301" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ElevationText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                <ui:Button Content="Restart as Administrator" Margin="16,0,0,0" VerticalAlignment="Center"
                           Command="{Binding RestartAsAdministratorCommand}" />
            </StackPanel>
        </Border>

        <!-- Disk list -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
            <ItemsControl ItemsSource="{Binding Disks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DiskCardViewModel}">
                        <!-- Tag carries the DashboardViewModel down so the ContextMenu (which lives in a
                             separate visual tree) can reach its commands via PlacementTarget.Tag. -->
                        <Border Background="#12FFFFFF" CornerRadius="12" Padding="18" Margin="0,0,0,16"
                                BorderBrush="#22FFFFFF" BorderThickness="1"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Create partition…"
                                              ToolTipService.ShowOnDisabled="True"
                                              ToolTip="{Binding PlacementTarget.DataContext.CreatePartitionHint,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              IsEnabled="{Binding PlacementTarget.DataContext.CanCreatePartition,
                                                          RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Command="{Binding PlacementTarget.Tag.OpenCreatePartitionOnDiskCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext.DiskNumber,
                                                                 RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Add24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Clone this disk…"
                                              ToolTipService.ShowOnDisabled="True"
                                              ToolTip="{Binding PlacementTarget.DataContext.CloneHint,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              IsEnabled="{Binding PlacementTarget.DataContext.CanClone,
                                                          RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Command="{Binding PlacementTarget.Tag.OpenCloneFromDiskCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext.DiskNumber,
                                                                 RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Copy24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <StackPanel>
                                <!-- Title row -->
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <Border Background="#33F59E0B" CornerRadius="4" Padding="6,1" Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsSystem, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="SYSTEM" FontSize="10" Foreground="#F5B301" />
                                        </Border>
                                        <Border Background="#333B82F6" CornerRadius="4" Padding="6,1" Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsBoot, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="BOOT" FontSize="10" Foreground="#6FA8FF" />
                                        </Border>
                                        <Border Background="#3334D399" CornerRadius="4" Padding="6,1" Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                ToolTip="The map below shows the batch you have staged, not the drive's current contents. Nothing has been written yet."
                                                Visibility="{Binding HasPlannedChanges, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="PLANNED CHANGES" FontSize="10" Foreground="#6EE7B7" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.85">
                                        <Run Text="{Binding SizeText, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="  ·  " />
                                        <Run Text="{Binding BusText, Mode=OneWay}" />
                                        <Run Text=" " />
                                        <Run Text="{Binding MediaText, Mode=OneWay}" />
                                        <Run Text="  ·  " />
                                        <Run Text="{Binding SchemeText, Mode=OneWay}" />
                                        <Run Text="  ·  " />
                                        <Run Text="{Binding HealthText, Mode=OneWay}" />
                                    </TextBlock>
                                </Grid>

                                <TextBlock Text="{Binding DetailText}" Opacity="0.6" FontSize="12" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ConnectionText}" Opacity="0.75" FontSize="12" Margin="0,3,0,0"
                                           TextWrapping="Wrap" />

                                <!-- Link speed mismatch warning (e.g. USB 3 drive in a USB 2 port) -->
                                <Border Margin="0,8,0,0" CornerRadius="6" Padding="10,7"
                                        Background="#26F59E0B" BorderBrush="#66F59E0B" BorderThickness="1"
                                        Visibility="{Binding ShowLinkMismatch, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Warning24" Foreground="#F5B301" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding LinkMismatchHint}" Foreground="#F5D08A" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" />
                                    </StackPanel>
                                </Border>

                                <!-- Partition map bar -->
                                <ItemsControl ItemsSource="{Binding Segments}" Height="46" Margin="0,14,0,0"
                                              HorizontalAlignment="Stretch">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PartitionSegmentViewModel}">
                                            <Button Margin="0,0,2,0" Padding="0" BorderThickness="0" Cursor="Hand"
                                                    Background="Transparent" ToolTip="{Binding Tooltip}"
                                                    Command="{Binding DataContext.OpenPartitionCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Width>
                                                    <MultiBinding Converter="{StaticResource FractionToWidth}">
                                                        <Binding Path="Fraction" />
                                                        <Binding Path="ActualWidth"
                                                                 RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                    </MultiBinding>
                                                </Button.Width>
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid Height="46">
                                                            <Border x:Name="Seg" CornerRadius="4"
                                                                    Background="{Binding Fill}" BorderBrush="Transparent"
                                                                    BorderThickness="2" />
                                                            <!-- Dashed outline = this region is planned, not present. -->
                                                            <Rectangle RadiusX="4" RadiusY="4" StrokeThickness="2"
                                                                       StrokeDashArray="3 2"
                                                                       Stroke="{Binding OutlineBrush}" />
                                                            <ContentPresenter />
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Seg" Property="BorderBrush" Value="#CCFFFFFF" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <StackPanel VerticalAlignment="Center" Margin="8,0" ClipToBounds="True">
                                                    <TextBlock Text="{Binding PendingBadge}" FontSize="9" FontWeight="Bold"
                                                               Foreground="{Binding OutlineBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="White" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding SubTitle}" FontSize="10"
                                                               Foreground="#DDFFFFFF" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock FontSize="11" Margin="0,6,0,0" Foreground="#6EE7B7" TextWrapping="Wrap"
                                           Text="Preview of the staged batch — dashed segments are not on the drive yet. Clear reverts it; Apply writes it."
                                           Visibility="{Binding HasPlannedChanges, Converter={StaticResource BoolToVis}}" />

                                <TextBlock Text="{Binding EncryptionText}" FontSize="12" Margin="0,12,0,0" Opacity="0.85" />
                                <TextBlock Text="{Binding CapabilityText}" FontSize="11" Margin="0,4,0,0" Opacity="0.55"
                                           TextWrapping="Wrap" />

                                <!-- Per-disk actions -->
                                <Grid Margin="0,12,0,0">
                                    <TextBlock Text="{Binding FormatBlockedReason}" FontSize="12" Opacity="0.6"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding CanFormat, Converter={StaticResource BoolToVisInverse}}" />
                                    <ui:Button Content="Format…" Icon="{ui:SymbolIcon Eraser24}"
                                               HorizontalAlignment="Right" IsEnabled="{Binding CanFormat}"
                                               Command="{Binding DataContext.OpenFormatCommand,
                                                         RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding DiskNumber}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Pending Operations -->
        <Border Grid.Row="3" Margin="0,12,0,16" CornerRadius="12" Padding="16"
                Background="#1AEF4444" BorderBrush="#44EF4444" BorderThickness="1"
                Visibility="{Binding HasPending, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Warning24" Foreground="#FCA5A5" VerticalAlignment="Center" />
                        <TextBlock Text="Pending Operations" FontWeight="SemiBold" FontSize="15"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PendingSummary}" Opacity="0.7" Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="Clear" ToolTip="Discard the whole batch and go back to what is really on the disks."
                                   Command="{Binding ClearPendingCommand}" MinWidth="80" />
                        <ui:Button Content="Apply" Appearance="Danger" Margin="10,0,0,0" MinWidth="120"
                                   IsEnabled="{Binding CanApplyBatch}"
                                   ToolTipService.ShowOnDisabled="True"
                                   Command="{Binding ApplyCommand}" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1" Text="{Binding BlockedSummary}" Foreground="#FCA5A5" FontSize="12"
                           Margin="34,10,0,0" TextWrapping="Wrap" />

                <ItemsControl Grid.Row="2" ItemsSource="{Binding PendingOps}" Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PendingOpViewModel}">
                            <Grid Margin="0,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{Binding Details}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding BlockedReason}" Foreground="#FCA5A5" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,3,0,0"
                                               Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <ui:Button Content="Remove" HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Command="{Binding DataContext.RemovePendingCommand,
                                                     RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>

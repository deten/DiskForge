<ui:FluentWindow x:Class="DiskForge.App.Views.PartitionDetailsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:conv="clr-namespace:DiskForge.App.Converters"
                 xmlns:vm="clr-namespace:DiskForge.App.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:PartitionDetailsViewModel}"
                 Title="Partition details" Height="600" Width="540"
                 WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInverse" Invert="True" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Partition details" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,8">
            <StackPanel>
                <TextBlock Text="{Binding Header}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />

                <Border Margin="0,12,0,0" CornerRadius="8" Padding="14,12" Background="#0DFFFFFF"
                        BorderBrush="#1FFFFFFF" BorderThickness="1">
                    <TextBlock Text="{Binding InfoText}" TextWrapping="Wrap" FontSize="13" LineHeight="21"
                               FontFamily="Consolas, Cascadia Mono, monospace" />
                </Border>

                <!-- Editable tasks -->
                <StackPanel Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Tasks" FontSize="15" FontWeight="SemiBold" Margin="0,20,0,8" />

                    <TextBlock Text="Volume label" Opacity="0.8" Margin="0,0,0,4" />
                    <ui:TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" />

                    <TextBlock Text="Drive letter" Opacity="0.8" Margin="0,12,0,4" />
                    <ComboBox ItemsSource="{Binding AvailableLetters}" SelectedItem="{Binding SelectedLetter}"
                              HorizontalAlignment="Left" MinWidth="90" />

                    <Border Margin="0,12,0,0" CornerRadius="6" Padding="10,7"
                            Background="#26EF4444" BorderBrush="#66EF4444" BorderThickness="1"
                            Visibility="{Binding HasStageError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding StageError}" Foreground="#FCA5A5" TextWrapping="Wrap" FontSize="12" />
                    </Border>
                </StackPanel>

                <Border Margin="0,16,0,0" CornerRadius="8" Padding="12,10" Background="#0DFFFFFF"
                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisInverse}}">
                    <TextBlock Text="{Binding CannotEditReason}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                </Border>

                <!-- Resize. Offered only where Windows can move the filesystem with the extent. -->
                <StackPanel Visibility="{Binding CanResize, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Resize" FontSize="15" FontWeight="SemiBold" Margin="0,20,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="{Binding MinResizeMb}" Maximum="{Binding MaxResizeMb}"
                                Value="{Binding ResizeMb}" IsSnapToTickEnabled="True" TickFrequency="1"
                                VerticalAlignment="Center" />
                        <!-- ValueChanged→UpdateSource: WPF-UI 3.0.5's NumberBox commits typed text into
                             Value on focus loss but its TwoWay binding does not push that to the source,
                             so a typed size would be silently discarded. Same fix as CreatePartitionWindow. -->
                        <ui:NumberBox x:Name="ResizeBox" Grid.Column="1" MinWidth="120" Margin="12,0,0,0"
                                      Value="{Binding ResizeMb, Mode=TwoWay}"
                                      ValueChanged="ResizeBox_ValueChanged"
                                      Minimum="{Binding MinResizeMb}" Maximum="{Binding MaxResizeMb}"
                                      SpinButtonPlacementMode="Compact" ClearButtonEnabled="False" />
                    </Grid>
                    <TextBlock Text="{Binding ResizeSummary}" Opacity="0.75" FontSize="12"
                               Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <Border Margin="0,16,0,0" CornerRadius="8" Padding="12,10" Background="#0DFFFFFF"
                        Visibility="{Binding CanResize, Converter={StaticResource BoolToVisInverse}}">
                    <TextBlock Text="{Binding ResizeBlockedReason}" Opacity="0.7" FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Filesystem health: a read-only chkdsk anywhere Windows has the volume mounted, and a
                     repair that follows the write ladder. Both stage into the batch like every other op. -->
                <Border Margin="0,16,0,0" CornerRadius="8" Padding="12,10" Background="#0DFFFFFF"
                        BorderBrush="#1FFFFFFF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Filesystem health" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                                   Text="Check runs a read-only chkdsk and reports what it finds. Repair runs chkdsk /f, which dismounts the volume for the duration and corrects errors in place. Both are staged and run at Apply." />
                        <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#FCA5A5" TextWrapping="Wrap"
                                   Text="{Binding CheckBlockedReason}"
                                   Visibility="{Binding CanCheck, Converter={StaticResource BoolToVisInverse}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <ui:Button x:Name="CheckButton" Content="Check (read-only)" Icon="{ui:SymbolIcon Stethoscope24}"
                                       IsEnabled="{Binding CanCheck}" Click="Check_Click" />
                            <ui:Button x:Name="RepairButton" Content="Repair" Icon="{ui:SymbolIcon Wrench24}"
                                       Margin="10,0,0,0" IsEnabled="{Binding CanRepair}" Click="Repair_Click"
                                       ToolTipService.ShowOnDisabled="True"
                                       ToolTip="chkdsk /f. Refused on the system disk, and on an internal disk until acknowledged below." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Internal-disk override for the write tasks (Delete, Repair) -->
                <Border Margin="0,16,0,0" CornerRadius="8" Padding="12,10"
                        Background="#26EF4444" BorderBrush="#66EF4444" BorderThickness="1"
                        Visibility="{Binding ShowInternalDiskGate, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="⚠ This partition is on an INTERNAL, non-removable disk." Foreground="#FCA5A5"
                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                        <CheckBox Content="I understand — allow deleting or repairing this partition"
                                  IsChecked="{Binding AllowNonRemovable}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#0AFFFFFF" Padding="24,14">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <ui:Button x:Name="FormatButton" Content="Format…" Icon="{ui:SymbolIcon Eraser24}"
                               IsEnabled="{Binding CanFormat}" Click="Format_Click" />
                    <ui:Button x:Name="DeleteButton" Content="Delete…" Icon="{ui:SymbolIcon Delete24}"
                               Margin="10,0,0,0" IsEnabled="{Binding CanDelete}" Click="Delete_Click" />
                    <ui:Button x:Name="ResizeButton" Content="Resize" Icon="{ui:SymbolIcon ArrowAutofitWidth24}"
                               Margin="10,0,0,0" IsEnabled="{Binding CanResize}" Click="Resize_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Close" MinWidth="80" Click="Close_Click" />
                    <ui:Button x:Name="StageButton" Content="Stage changes" Appearance="Primary" MinWidth="120"
                               Margin="10,0,0,0" IsEnabled="{Binding CanEdit}" Click="Stage_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>

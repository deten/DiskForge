<ui:FluentWindow x:Class="DiskForge.App.Views.CreatePartitionWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:conv="clr-namespace:DiskForge.App.Converters"
                 xmlns:vm="clr-namespace:DiskForge.App.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:CreatePartitionDialogViewModel}"
                 Title="Create partition" Height="680" Width="560"
                 WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInverse" Invert="True" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Create partition" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,8,24,8">
            <StackPanel>
                <TextBlock Text="{Binding DiskHeader}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DiskIdentity}" Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding FreeSpaceText}" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap" />

                <!-- Internal-disk override -->
                <Border Margin="0,14,0,0" CornerRadius="8" Padding="12,10"
                        Background="#26EF4444" BorderBrush="#66EF4444" BorderThickness="1"
                        Visibility="{Binding DiskIsRemovable, Converter={StaticResource BoolToVisInverse}}">
                    <StackPanel>
                        <TextBlock Text="⚠ This is an INTERNAL, non-removable disk." Foreground="#FCA5A5" FontWeight="SemiBold" />
                        <CheckBox Content="I understand — allow partitioning this internal disk"
                                  IsChecked="{Binding AllowNonRemovable}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Size (MB)" Margin="0,18,0,4" FontWeight="SemiBold" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" Minimum="{Binding MinSizeMb}" Maximum="{Binding MaxSizeMb}"
                            Value="{Binding SizeMb}" IsSnapToTickEnabled="True" TickFrequency="1"
                            VerticalAlignment="Center" />
                    <!-- ValueChanged→UpdateSource is required: WPF-UI 3.0.5's NumberBox commits typed
                         text into Value on focus loss, but its TwoWay binding does not push that to
                         the source, so a typed size was silently discarded in favour of the slider's.
                         See SizeBox_ValueChanged. -->
                    <ui:NumberBox x:Name="SizeBox" Grid.Column="1" Minimum="{Binding MinSizeMb}"
                                  Value="{Binding SizeMb, Mode=TwoWay}"
                                  ValueChanged="SizeBox_ValueChanged"
                                  Maximum="{Binding MaxSizeMb}" MinWidth="120" Margin="12,0,0,0"
                                  SpinButtonPlacementMode="Compact" ClearButtonEnabled="False" />
                </Grid>

                <TextBlock Text="Drive letter" Margin="0,14,0,4" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding AvailableLetters}" SelectedItem="{Binding SelectedLetter}"
                          IsEnabled="{Binding CanChooseLetter}"
                          HorizontalAlignment="Left" MinWidth="110" />
                <TextBlock Text="Not applicable to a Linux filesystem — Windows cannot mount it."
                           Opacity="0.6" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                           Visibility="{Binding IsLinuxFileSystem, Converter={StaticResource BoolToVis}}" />

                <CheckBox Content="Format the new partition" IsChecked="{Binding FormatNew}" Margin="0,16,0,0" />

                <StackPanel Visibility="{Binding FormatNew, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="File system" Margin="0,14,0,4" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding FileSystemOptions}" DisplayMemberPath="Display"
                              SelectedValuePath="Value" SelectedValue="{Binding SelectedFileSystem}"
                              HorizontalAlignment="Stretch">
                        <!-- Unavailable Linux filesystems stay visible but disabled, with the reason
                             (and the fix) in the tooltip. -->
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                                <Setter Property="ToolTip" Value="{Binding Reason}" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <TextBlock Text="{Binding LinuxBackendText}" Opacity="0.6" FontSize="12"
                               TextWrapping="Wrap" Margin="0,6,0,0" />

                    <Border Margin="0,12,0,0" CornerRadius="8" Padding="12,10"
                            Background="#264F46E5" BorderBrush="#666366F1" BorderThickness="1"
                            Visibility="{Binding IsLinuxFileSystem, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Linux filesystem" FontWeight="SemiBold" Foreground="#C7D2FE" />
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12" Opacity="0.9"
                                       Text="Written by the real mkfs tools inside WSL2 after the partition is
                                             created. Windows has no driver for it, so the new volume will show as
                                             unformatted (RAW) in Explorer — that is expected. The partition is
                                             tagged as Linux filesystem data so Windows leaves it alone." />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Volume label" Margin="0,14,0,4" FontWeight="SemiBold" />
                    <ui:TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                MaxLength="{Binding LabelMaxLength}" />

                    <CheckBox Content="{Binding FullFormatText}" IsChecked="{Binding FullFormat}"
                              Margin="0,14,0,0" />
                </StackPanel>

                <Border Margin="0,18,0,0" CornerRadius="8" Padding="14,12" Background="#0DFFFFFF"
                        BorderBrush="#1FFFFFFF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="What will happen" FontWeight="SemiBold" Opacity="0.8" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding SimulationText}" TextWrapping="Wrap" FontSize="13" LineHeight="20" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" CornerRadius="8" Padding="14,12"
                        Background="#26EF4444" BorderBrush="#66EF4444" BorderThickness="1"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ValidationText}" Foreground="#FCA5A5" TextWrapping="Wrap" FontSize="13" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#0AFFFFFF" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="CancelButton" Content="Cancel" MinWidth="90" Click="Cancel_Click" />
                <ui:Button x:Name="AddButton" Content="Add to plan" Appearance="Primary" MinWidth="120"
                           Margin="10,0,0,0" IsEnabled="{Binding CanConfirm}" Click="Add_Click" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
